# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# custom
/.git-exclude/
*.local.json

# mdBook build output (docs/src is the source; docs/book is generated)
docs/book

# makepkg build output for packaging/aur (PKGBUILD and .SRCINFO are the source; these are not)
packaging/aur/src/
packaging/aur/pkg/
packaging/aur/*.pkg.tar.*
packaging/aur/*.log
packaging/aur/*.crate

# same, for the tekstide-bin package's own subdirectory -- it never downloads a .crate, so no
# pattern for one here
packaging/aur/tekstide-bin/src/
packaging/aur/tekstide-bin/pkg/
packaging/aur/tekstide-bin/*.pkg.tar.*
packaging/aur/tekstide-bin/*.log

# reusable test fixtures (large or slow to produce: a previous release's build, a real
# downloaded asset) -- the files themselves are not committed, but README.md and
# checksums.sha256 are, per that README's own convention
rfcs/handoffs/fixtures/*
!rfcs/handoffs/fixtures/README.md
!rfcs/handoffs/fixtures/checksums.sha256
